BIND_ADDR=127.0.0.1
EKUMETRICS_VERSION=1.0.0
PUBLIC_HOST=localhost
# Valores exclusivos para desarrollo local. Sustitúyalos antes de usar datos reales o exponer servicios.
POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Debe ser un valor aleatorio de al menos 32 bytes.
INGEST_SHARED_KEY=change-me-with-at-least-32-random-bytes
# Firma independiente de tokens de pantallas; no reutilice ninguna otra clave.
KIOSK_TOKEN_SECRET=change-me-with-at-least-32-random-bytes
# Cifra los tokens OIDC que el BFF guarda en PostgreSQL.
BFF_SESSION_SECRET=change-me-with-at-least-32-random-bytes
# Clave independiente para credenciales de proveedores de IA.
AI_SETTINGS_ENCRYPTION_KEY=change-me-with-at-least-32-random-bytes
EVENT_RETENTION_DAYS=30
EVENT_RETENTION_INTERVAL_MS=3600000
EVENT_RETENTION_BATCH_SIZE=1000
EVENT_RETENTION_MAX_BATCHES=20
AI_INQUIRY_RETENTION_DAYS=90
AI_INQUIRY_RETENTION_INTERVAL_MS=3600000
AI_INQUIRY_RETENTION_BATCH_SIZE=500
PROMETHEUS_RETENTION_SIZE=10GB
