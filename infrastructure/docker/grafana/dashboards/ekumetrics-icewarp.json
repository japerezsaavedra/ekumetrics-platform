{
  "uid": "ekms-icewarp",
  "title": "Ekumetrics — IceWarp",
  "description": "Servicios, sesiones, SMTP y defensa del IceWarp Server (SNMP 1161). Los contadores SMTP se muestran como incremento del rango.",
  "tags": ["ekumetrics", "icewarp", "correo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "agent_id",
        "label": "Agente",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(icewarp_svc_running, agent_id)",
        "refresh": 2,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios arriba",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [
        { "refId": "A", "expr": "count(icewarp_svc_running{agent_id=\"$agent_id\"} == 1) or vector(0)", "legendFormat": "arriba" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sesiones",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(icewarp_svc_sessions{agent_id=\"$agent_id\"}) or vector(0)", "legendFormat": "sesiones" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SMTP recibidos",
      "description": "Incremento de icewarp_smtp_in en el rango seleccionado.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" },
      "targets": [
        { "refId": "A", "expr": "clamp_min(sum(delta(icewarp_smtp_in{agent_id=\"$agent_id\"}[$__range])), 0) or vector(0)", "legendFormat": "in" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SMTP enviados",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" },
      "targets": [
        { "refId": "A", "expr": "clamp_min(sum(delta(icewarp_smtp_out{agent_id=\"$agent_id\"}[$__range])), 0) or vector(0)", "legendFormat": "out" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rechazos",
      "description": "Fallidos + virus + content filter + DNSBL + tarpit + spam en el rango.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(sum(delta(icewarp_smtp_failed{agent_id=\"$agent_id\"}[$__range])), 0) + clamp_min(sum(delta(icewarp_smtp_virus{agent_id=\"$agent_id\"}[$__range])), 0) + clamp_min(sum(delta(icewarp_smtp_cf{agent_id=\"$agent_id\"}[$__range])), 0) + clamp_min(sum(delta(icewarp_smtp_dnsbl{agent_id=\"$agent_id\"}[$__range])), 0) + clamp_min(sum(delta(icewarp_smtp_tarpit{agent_id=\"$agent_id\"}[$__range])), 0) + clamp_min(sum(delta(icewarp_smtp_spam{agent_id=\"$agent_id\"}[$__range])), 0)",
          "legendFormat": "rechazos"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Puertos",
      "description": "Sondas TCP 25/587/143/993/443 del agente (icewarp.probe).",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value" },
      "targets": [
        { "refId": "A", "expr": "count(ekms_probe_up{agent_id=\"$agent_id\",name=~\".+-(25|587|143|993|443)\"} == 1) or vector(0)", "legendFormat": "arriba" }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Servicios IceWarp",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "running" }, "properties": [{ "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "Parado", "color": "red" }, "1": { "text": "Activo", "color": "green" } } }] }] },
          { "matcher": { "id": "byName", "options": "uptime" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "virtual" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "icewarp_svc" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true },
            "renameByName": {
              "icewarp_svc": "servicio",
              "Value #A": "running",
              "Value #B": "uptime",
              "Value #C": "sesiones",
              "Value #D": "pico",
              "Value #E": "virtual"
            }
          }
        }
      ],
      "targets": [
        { "refId": "A", "expr": "icewarp_svc_running{agent_id=\"$agent_id\"}", "format": "table", "instant": true },
        { "refId": "B", "expr": "icewarp_svc_uptime{agent_id=\"$agent_id\"} / 100", "format": "table", "instant": true },
        { "refId": "C", "expr": "icewarp_svc_sessions{agent_id=\"$agent_id\"}", "format": "table", "instant": true },
        { "refId": "D", "expr": "icewarp_svc_sessions_peak{agent_id=\"$agent_id\"}", "format": "table", "instant": true },
        { "refId": "E", "expr": "(icewarp_svc_working_set{agent_id=\"$agent_id\"} + 4294967296 * (icewarp_svc_working_set{agent_id=\"$agent_id\"} < bool 0)) * on(icewarp_svc) group_left() (icewarp_svc_running{agent_id=\"$agent_id\"} == 1)", "format": "table", "instant": true }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Sesiones por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "icewarp_svc_sessions{agent_id=\"$agent_id\"}", "legendFormat": "{{icewarp_svc}}" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memoria virtual por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(icewarp_svc_working_set{agent_id=\"$agent_id\"} + 4294967296 * (icewarp_svc_working_set{agent_id=\"$agent_id\"} < bool 0)) * on(icewarp_svc) group_left() (icewarp_svc_running{agent_id=\"$agent_id\"} == 1)", "legendFormat": "{{icewarp_svc}}" }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Correo SMTP (incremento)",
      "description": "delta del MIB: in / out / failed. Son gauges acumulativos.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "clamp_min(sum(delta(icewarp_smtp_in{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "recibidos" },
        { "refId": "B", "expr": "clamp_min(sum(delta(icewarp_smtp_out{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "enviados" },
        { "refId": "C", "expr": "clamp_min(sum(delta(icewarp_smtp_failed{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "fallidos" }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Defensa SMTP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "clamp_min(sum(delta(icewarp_smtp_virus{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "virus" },
        { "refId": "B", "expr": "clamp_min(sum(delta(icewarp_smtp_spam{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "spam" },
        { "refId": "C", "expr": "clamp_min(sum(delta(icewarp_smtp_dnsbl{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "DNSBL" },
        { "refId": "D", "expr": "clamp_min(sum(delta(icewarp_smtp_cf{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "content filter" },
        { "refId": "E", "expr": "clamp_min(sum(delta(icewarp_smtp_tarpit{agent_id=\"$agent_id\"}[$__rate_interval])), 0)", "legendFormat": "tarpit" }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Sondas de puertos (RTT)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "ekms_probe_rtt_seconds{agent_id=\"$agent_id\",name=~\".+-(25|587|143|993|443)\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Sondas de puertos (up)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "ekms_probe_up{agent_id=\"$agent_id\",name=~\".+-(25|587|143|993|443)\"}", "legendFormat": "{{name}}" }
      ]
    }
  ]
}
