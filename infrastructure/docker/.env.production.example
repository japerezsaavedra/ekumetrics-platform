BIND_ADDR=127.0.0.1
EKUMETRICS_VERSION=1.0.0
PORTAL_PUBLIC_URL=https://monitoring.example.com
API_PUBLIC_URL=https://api.example.com
GRAFANA_PUBLIC_URL=https://grafana.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com

# El gestor externo debe materializar aquí archivos 0400/0440 para el usuario del contenedor.
SECRETS_DIR=/etc/ekumetrics/secrets
AGENT_TLS_DIR=/etc/ekumetrics/agent-tls
AGENT_EDGE_BIND_ADDR=0.0.0.0
AGENT_PUBLIC_HOST=ingest.example.com
AGENT_GRPC_PORT=4317
AGENT_HTTP_PORT=4318
KEYCLOAK_ADMIN_USERNAME=change-me-admin-user
EVENT_RETENTION_DAYS=30
EVENT_RETENTION_INTERVAL_MS=3600000
EVENT_RETENTION_BATCH_SIZE=1000
EVENT_RETENTION_MAX_BATCHES=20
AI_INQUIRY_RETENTION_DAYS=90
AI_INQUIRY_RETENTION_INTERVAL_MS=3600000
AI_INQUIRY_RETENTION_BATCH_SIZE=500
PROMETHEUS_RETENTION_SIZE=10GB
