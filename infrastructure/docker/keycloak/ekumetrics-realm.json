{
  "realm": "ekumetrics",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Operador Gradotech" },
      { "name": "admin", "description": "Administrador del tenant" },
      { "name": "viewer", "description": "Solo lectura" }
    ]
  },
  "clients": [
    {
      "clientId": "portal-web",
      "name": "Ekumetrics Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*", "http://127.0.0.1:4200/*"],
      "webOrigins": ["http://localhost:4200", "http://127.0.0.1:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://127.0.0.1:4200/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "portal-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "email": "operator@gradotech.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Operador",
      "lastName": "Gradotech",
      "credentials": [{ "type": "password", "value": "ekumetrics", "temporary": false }],
      "realmRoles": ["operator"],
      "attributes": { "tenant": ["default"] }
    },
    {
      "username": "admin",
      "email": "admin@gradotech.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Gradotech",
      "credentials": [{ "type": "password", "value": "ekumetrics", "temporary": false }],
      "realmRoles": ["admin"],
      "attributes": { "tenant": ["default"] }
    }
  ]
}
