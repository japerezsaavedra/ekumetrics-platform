#!/bin/sh
set -eu

if [ -n "${INGEST_SHARED_KEY_FILE:-}" ]; then
  [ -r "$INGEST_SHARED_KEY_FILE" ] || { echo 'No se puede leer INGEST_SHARED_KEY_FILE.' >&2; exit 1; }
  INGEST_SHARED_KEY=$(cat "$INGEST_SHARED_KEY_FILE")
  [ -n "$INGEST_SHARED_KEY" ] || { echo 'INGEST_SHARED_KEY_FILE está vacío.' >&2; exit 1; }
  export INGEST_SHARED_KEY
  unset INGEST_SHARED_KEY_FILE
fi
