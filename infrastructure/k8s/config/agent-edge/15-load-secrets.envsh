#!/bin/sh
set -eu

load_secret() {
  name="$1"
  eval "file=\${${name}_FILE:-}"
  [ -n "$file" ] || { echo "Falta ${name}_FILE." >&2; exit 1; }
  [ -r "$file" ] || { echo "No se puede leer ${name}_FILE." >&2; exit 1; }
  value=$(cat "$file")
  [ -n "$value" ] || { echo "${name}_FILE está vacío." >&2; exit 1; }
  export "$name=$value"
  unset "${name}_FILE"
}

load_secret INGEST_SHARED_KEY
load_secret AGENT_EDGE_ASSERTION_KEY
