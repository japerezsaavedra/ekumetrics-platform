server {
  listen 4317 ssl;
  http2 on;
  server_name _;

  ssl_certificate /run/agent-tls/server.crt;
  ssl_certificate_key /run/agent-tls/server.key;
  ssl_client_certificate /run/agent-tls/ca.crt;
  ssl_verify_client on;
  ssl_verify_depth 2;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;

  location / {
    grpc_set_header X-Ekumetrics-Client-DN $ssl_client_s_dn;
    grpc_pass grpc://otel-collector:4317;
  }
}

server {
  listen 4318 ssl;
  server_name _;
  client_max_body_size 4m;

  ssl_certificate /run/agent-tls/server.crt;
  ssl_certificate_key /run/agent-tls/server.key;
  ssl_client_certificate /run/agent-tls/ca.crt;
  ssl_verify_client on;
  ssl_verify_depth 2;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;

  location = /v1/ekms/events {
    limit_except POST { deny all; }
    proxy_http_version 1.1;
    proxy_set_header X-Ekumetrics-Ingest-Key "${INGEST_SHARED_KEY}";
    proxy_set_header X-Ekumetrics-Edge-Assertion "${AGENT_EDGE_ASSERTION_KEY}";
    proxy_set_header X-Ekumetrics-Client-DN $ssl_client_s_dn;
    proxy_set_header Content-Type $content_type;
    proxy_set_header Content-Encoding $http_content_encoding;
    proxy_pass http://platform-api:3000;
  }

  location /v1/ {
    proxy_http_version 1.1;
    proxy_set_header X-Ekumetrics-Client-DN $ssl_client_s_dn;
    proxy_pass http://otel-collector:4318;
  }

  location / {
    return 404;
  }
}

server {
  listen 8081;
  server_name _;

  location = /healthz {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok","service":"agent-edge"}\n';
  }

  location / {
    return 404;
  }
}
