{
  "name": "portal-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"*.json\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"*.json\""
  },
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "cytoscape": "^3.34.2",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "marked": "^18.0.11",
    "material-symbols": "^0.47.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.3",
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
