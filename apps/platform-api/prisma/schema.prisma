generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emailDomain String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  sites           Site[]
  agents          Agent[]
  assets          Asset[]
  policies        Policy[]
  incidents       Incident[]
  auditLogs       AuditLog[]
  events          AgentEvent[]
  kioskDevices    KioskDevice[]
  aiConversations AiConversation[]
  aiInquiries     AiInquiry[]
  knowledgeDocuments AiKnowledgeDocument[]
  alertChannels      AlertChannel[]
  identity           TenantIdentity?
  customDashboards   CustomDashboard[]
  thresholds         PlatformThresholds[]
  graphNodes         GraphNode[]
  graphEdges         GraphEdge[]
}

model Site {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kioskDevices     KioskDevice[]
  customDashboards CustomDashboard[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CustomDashboard {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name      String
  widgets   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
}

model KioskDevice {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  dashboard           String
  secretHash          String
  credentialExpiresAt DateTime
  credentialVersion   Int       @default(1)
  revokedAt           DateTime?
  lastSeenAt          DateTime?
  lastRenewedAt       DateTime?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([revokedAt])
}

model User {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String
  displayName        String
  role               String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedIncidents Incident[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Agent {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId    String
  siteId     String
  mode       String    @default("site")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assets Asset[]
  events AgentEvent[]

  @@unique([tenantId, agentId])
  @@index([tenantId])
  @@index([siteId])
}

model Asset {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  assetKey       String
  assetType      String?
  vendor         String?
  status         String    @default("known")
  lastObservedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  incidents Incident[]

  @@unique([tenantId, assetKey])
  @@index([tenantId])
  @@index([agentId])
}

model AgentEvent {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  siteId      String
  assetKey    String?
  assetType   String?
  vendor      String?
  tier        Int?
  signal      String
  value       Float
  unit        String?
  severity    String?
  source      String
  tags        Json?
  eventAt     DateTime
  receivedAt  DateTime @default(now())

  @@index([tenantId, eventAt])
  @@index([agentId, eventAt])
  @@index([signal, eventAt])
  @@index([assetKey, eventAt])
}

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Incident {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title       String
  status      IncidentStatus @default(open)
  severity    String
  siteId      String?
  clusterKey  String?
  causeKey    String?
  causeName   String?
  confidence  Float?
  windowStart DateTime?
  windowEnd   DateTime?
  alertCount  Int            @default(0)
  eventCount  Int            @default(0)
  members     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, clusterKey])
  @@index([tenantId])
  @@index([status])
  @@index([assetId])
  @@index([siteId])
}

model GraphNode {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId     String
  nodeKey    String
  kind       String
  name       String
  source     String
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, nodeKey])
  @@index([tenantId, siteId])
  @@index([tenantId, lastSeenAt])
}

model GraphEdge {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId     String
  fromKey    String
  toKey      String
  relation   String
  source     String
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, fromKey, toKey, relation, source])
  @@index([tenantId, siteId])
  @@index([tenantId, fromKey])
  @@index([tenantId, toKey])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdAt])
}

model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor     String
  title     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiries AiInquiry[]

  @@index([tenantId, actor, updatedAt])
  @@index([expiresAt])
}

model AiInquiry {
  id                  String          @id @default(cuid())
  tenantId            String?
  tenant              Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor               String?
  conversationId      String?
  conversation        AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider            String
  model               String
  question            String
  analysis            String
  evidence            Json?
  conversationContext Json?
  entities            Json?
  periodStart         DateTime?
  periodEnd           DateTime?
  sourceStatus        Json?
  retentionUntil      DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([createdAt])
  @@index([provider])
  @@index([tenantId, actor, conversationId, createdAt])
  @@index([retentionUntil])
}

model AiSettings {
  id           String   @id @default(cuid())
  slot         String   @unique @default("default")
  service      String
  model        String
  apiKey       String?
  baseUrl      String?
  vault        Json?
  systemPrompt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slot])
}

model AiKnowledgeDocument {
  id          String    @id
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceKey   String
  sourceType  String
  title       String
  version     String
  component   String?
  checksum    String
  approvedBy  String
  approvedAt  DateTime
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chunks AiKnowledgeChunk[]

  @@index([tenantId, sourceType, component])
  @@index([validFrom, validUntil, deletedAt])
}

model AiKnowledgeChunk {
  id             String   @id
  documentId     String
  document       AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal        Int
  heading        String?
  content        String
  contentHash    String
  tokenCount     Int
  embeddingModel String?
  embedding      Unsupported("vector(1024)")?
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime @default(now())

  @@unique([documentId, ordinal])
  @@index([documentId])
}

model TenantIdentity {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mfaRequired       Boolean  @default(false)
  entraEnabled      Boolean  @default(false)
  entraTenantId     String?
  entraClientId     String?
  entraClientSecret String?
  adEnabled         Boolean  @default(false)
  adConnectionUrl   String?
  adBindDn          String?
  adBindPassword    String?
  adUsersDn         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model AlertChannel {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  type       String
  enabled    Boolean  @default(true)
  severities String[]
  configEnc  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model WebSession {
  sessionHash     String    @id
  encryptedTokens String
  subject         String
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([subject])
}

model PlatformThresholds {
  id        String   @id @default(cuid())
  slot      String   @unique
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum IncidentStatus {
  open
  acknowledged
  resolved
  closed
}
