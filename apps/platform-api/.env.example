# DEEPSEEK_API_KEY=
# OpenClaw, OpenRouter, Azure u otro endpoint OpenAI-compatible
# AI_COMPAT_BASE_URL=https://api.openrouter.ai/v1
# AI_COMPAT_API_KEY=
# AI_COMPAT_MODEL=openai/gpt-4.1-mini
# Firma de sesiones de dispositivos kiosk (mínimo 32 caracteres; use un valor aleatorio por entorno).
KIOSK_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Retención acotada y por lotes de eventos operativos.
EVENT_RETENTION_DAYS=30
EVENT_RETENTION_INTERVAL_MS=3600000
EVENT_RETENTION_BATCH_SIZE=1000
EVENT_RETENTION_MAX_BATCHES=20
# Retención server-side de conversaciones e investigaciones de EkuAssistant.
AI_INQUIRY_RETENTION_DAYS=90
AI_INQUIRY_RETENTION_INTERVAL_MS=3600000
AI_INQUIRY_RETENTION_BATCH_SIZE=500
