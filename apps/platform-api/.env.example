PORT=3000
INGEST_SHARED_KEY=change-me-with-at-least-32-random-bytes
DATABASE_URL=postgresql://ekumetrics:change-me-postgres@localhost:5432/ekumetrics?schema=public
CORS_ORIGIN=http://localhost:4200
PORTAL_PUBLIC_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=ekumetrics
KEYCLOAK_AUDIENCE=portal-web
KEYCLOAK_CLIENT_ID=portal-web
# Cifra tokens de sesión BFF en PostgreSQL (mínimo 32 caracteres aleatorios).
BFF_SESSION_SECRET=replace-with-at-least-32-random-characters
# Cifra credenciales de proveedores de IA persistidas (clave distinta a BFF).
AI_SETTINGS_ENCRYPTION_KEY=replace-with-another-32-character-random-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ekumetrics
KEYCLOAK_ADMIN_REALM=master
HOLMES_URL=http://localhost:5050
HOLMES_UPSTREAM_KEY=holmes-local
PROMETHEUS_URL=http://127.0.0.1:9091
LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200
OTEL_SERVICE_NAME=ekumetrics-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
AI_DEFAULT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/v1
AI_EMBEDDING_URL=http://127.0.0.1:11434
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# ChatGPT
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Claude
# ANTHROPIC_API_KEY=
# Kimi / Moonshot
# MOONSHOT_API_KEY=
# Grok / xAI
# XAI_API_KEY=
